rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      // DEV: allow without auth for now. Tighten before production.
      allow read, write: if true;
    }

    match /itineraries/{itineraryId} {
      // DEV: open access to enable creating trips without sign-in.
      allow read, create, update, delete: if true;
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (request.auth.uid in resource.data.memberUserIds);

      match /expenses/{expenseId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUserIds);
        allow create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUserIds);
        allow update, delete: if false;
      }

      match /invites/{inviteCode} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUserIds);
      }
    }
  }
}